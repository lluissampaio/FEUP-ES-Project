<file path="hooks/useSupermarkets.js">
import { db } from "@/firebaseConfig";
import { calculateDistance } from "@/utils/distance";
import { formatTime } from "@/utils/time";
import { collection, getDocs } from "firebase/firestore";
import { useEffect, useState } from "react";


export function useSupermarkets(userLat, userLon) {
  const [supermarkets, setSupermarkets] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    async function fetchSupermarkets() {
      setLoading(true);
      try {
        const querySnapshot = await getDocs(collection(db, "stores"));
        const data = querySnapshot.docs.map((doc) => {
          const dbData = doc.data();
          
          let dist = null;
          // Fallback de segurança (Null Safety). 
          if (dbData.location && userLat && userLon) {
            dist = calculateDistance(userLat, userLon, dbData.location.latitude, dbData.location.longitude);
          }

          const today = new Date();
          const currentMinutes = today.getHours() * 60 + today.getMinutes();
          const todaySchedule = dbData.schedule ? dbData.schedule[today.getDay()] : null;
          
          let isOpen = false;
          let scheduleToday = "Indisponível";

          if (todaySchedule) {
            isOpen = currentMinutes >= todaySchedule.opening && currentMinutes <= todaySchedule.closing;
            scheduleToday = `${formatTime(todaySchedule.opening)}-${formatTime(todaySchedule.closing)}`;
          }

          return {
            id: doc.id,
            name: dbData.name || "Sem Nome",
            rawDistance: dist,
            formattedDistance: dist ? `${dist.toFixed(1)} km` : "N/A",
            isOpen, 
            scheduleToday 
          };
        });
        setSupermarkets(data);
      } catch (error) {
        console.error("Erro ao buscar supermercados:", error);
      } finally {
        setLoading(false);
      }
    }
    fetchSupermarkets();
  }, [userLat, userLon]);

  return { supermarkets, loading };
}
</file>

<file path="app/index.jsx">
import { router } from 'expo-router';
import { StyleSheet, TextInput, Pressable, Alert, ActivityIndicator } from 'react-native';
import { signInWithEmailAndPassword } from 'firebase/auth';
import { auth } from '@/firebaseConfig';

import Spacer from '@/components/Spacer';
import ThemedButton from '@/components/ThemedButton';
import ThemedText from '@/components/ThemedText';
import ThemedView from '@/components/ThemedView';
import { Colors } from '@/constants/colors'
import { useState } from 'react';

export default function Login() {
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [loading, setLoading] = useState(false);

  const handleLogin = async () => {
    // Verificação email/password
    if (!email || !password) {
      Alert.alert('Erro', 'Por favor preencha todos os campos');
      return;
    }
    
    setLoading(true);

    try{
      await signInWithEmailAndPassword(auth, email, password);
      router.replace('/(tabs)');
    } catch (error) {
      console.error('Erro login:', error);
      Alert.alert('Erro', 'Email ou password incorretos');
    } finally {
      setLoading(false);
    }
  };

  const handleForgotPassword = () => {
    Alert.alert('Recuperar password', 'Função ainda não implementada');
  };

  const handleRegister = () => {
    router.push('/register'); // Vai para o ecrã de registo (register.jsx)
  };

  return (
    <ThemedView safe style={styles.container}>
      {/* Titulo */}
      <ThemedText title style={styles.logoText}>Log in</ThemedText>
      
      <Spacer height={30} />

      {/* Subtítulo */}
      <ThemedText style={styles.subtitle}>Insira as suas credenciais</ThemedText>

      <Spacer height={30} />

      {/* Email */}
      <ThemedText style={styles.label}>Email</ThemedText>
      <TextInput
        testID='email-input'
        style={styles.input}
        value={email}
        onChangeText={setEmail}
        placeholderTextColor="#999"
        keyboardType="email-address"
        autoCapitalize="none"
        editable={!loading}
      />

      <Spacer height={16} />

      {/* Password */}
      <ThemedText style={styles.label}>Password</ThemedText>
      <TextInput
        testID='password-input'
        style={styles.input}
        value={password}
        onChangeText={setPassword}
        placeholderTextColor="#999"
        secureTextEntry
        editable={!loading}
      />

      <Spacer height={12} />

      {/* Link recuperação da password */}
      <Pressable
        testID='forgot-password'
        onPress={handleForgotPassword}>
        <ThemedText style={styles.forgotPassword}>
          Esqueceu-se da sua password?
        </ThemedText>
      </Pressable>

      <Spacer height={30} />

      {/* Botão de Log In */}
      <ThemedButton 
        testID='login-button'
        onPress={handleLogin}
        style={styles.loginButton}
        disabled={loading}
      >
        {loading ? (
          <ActivityIndicator color="#fff" />
        ) : (
          <ThemedText style={styles.buttonText}>Log In</ThemedText>
        )}
      </ThemedButton>

      <Spacer height={20} />

      {/* Link Registe-se */}
      <Pressable 
        testID='register'
        onPress={handleRegister}>
        <ThemedText style={styles.registerText}>
          Não tem uma conta? <ThemedText style={styles.registerLink}>Registe-se</ThemedText>
        </ThemedText>
      </Pressable>
    </ThemedView>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    paddingHorizontal: 24,
    justifyContent: 'center',
  },
  logoText: {
    fontSize: 32,
    fontWeight: 'bold',
    textAlign: 'center',
    marginBottom: 8,
  },
  subtitle: {
    fontSize: 16,
    textAlign: 'center',
    opacity: 0.7,
  },
  label: {
    fontSize: 14,
    marginBottom: 8,
    fontWeight: '500',
  },
  input: {
    borderWidth: 1,
    borderColor: '#ccc',
    borderRadius: 8,
    paddingHorizontal: 16,
    paddingVertical: 12,
    fontSize: 16,
    backgroundColor: '#f9f9f9',
  },
  forgotPassword: {
    textAlign: 'right',
    fontSize: 13,
    opacity: 0.7,
  },
  loginButton: {
    borderRadius: 8,
    paddingVertical: 14,
  },
  buttonText: {
    color: '#fff',
    textAlign: 'center',
    fontSize: 16,
    fontWeight: '600',
  },
  registerText: {
