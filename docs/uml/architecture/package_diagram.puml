@startuml

top to bottom direction

package "Presentation" {
  package "Navigation" {
    [RootLayout]
    [TabsLayout]
  }
  package "Screens" {
    [Login]
    [Shop]
    [Explore]
    [Cart]
    [Favourite]
    [Account]
  }
  package "Components" {
    [ThemedView]
    [ThemedText]
    [ThemedButton]
    [CartItemRow]
    [Spacer]
    [AppIcon]
  }
  package "Assets" {
    [Images]
    [Fonts]
  }
}

package "Application Logic" {
  package "Constants" {
    [Colors]
    [Icons]
  }
  package "Hooks" {
    [useCart]
  }
}

[Navigation] ..> [Screens] : routes to
[Screens] ..> [Components] : uses
[Cart] ..> [useCart] : uses
[Components] ..> [Colors] : uses
[AppIcon] ..> [Icons] : uses

@enduml
