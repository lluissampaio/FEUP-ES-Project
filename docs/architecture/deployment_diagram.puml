@startuml

node "Developer Machine" {
  artifact "Source Code"
  node "Expo CLI" {
    artifact "Metro Bundler"
  }
}

node "Mobile Device" {
  node "iOS / Android OS" {
    node "Expo Go / Native App" {
      artifact "React Native Runtime"
      artifact "JavaScript Bundle"
    }
  }
}

node "Distribution" {
  node "Apple App Store" {
    artifact "iOS Build (.ipa)"
  }
  node "Google Play Store" {
    artifact "Android Build (.apk/.aab)"
  }
}

"Developer Machine" --> "Mobile Device" : HTTP (LAN / tunnel)\nDev mode
"Developer Machine" --> "Distribution" : expo build / eas build
"Distribution" --> "Mobile Device" : download & install

@enduml
